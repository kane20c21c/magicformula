	</dict>
	<key>Label</key>
	<string>com.stolab.magic-formula.daily-signal</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/kaneyoun/DriveForALL/StoLab/StockPortfolio/scripts/infra/run_batch.sh</string>
		<string>magic-formula.daily-signal</string>
		<string>/usr/bin/env</string>
		<string>python3</string>
		<string>/Users/kaneyoun/DriveForALL/StoLab/MagicFormula/scripts/daily_signal.py</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/kaneyoun/DriveForALL/StoLab/MagicFormula/output/logs/daily_signal.err</string>
	<key>StandardOutPath</key>
	<string>/Users/kaneyoun/DriveForALL/StoLab/MagicFormula/output/logs/daily_signal.out</string>
	<key>StartCalendarInterval</key>
	<array>
<dict>
			<key>Hour</key>
			<integer>20</integer>
			<key>Minute</key>
			<integer>40</integer>
			<key>Weekday</key>
			<integer>1</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>20</integer>
			<key>Minute</key>
			<integer>40</integer>
			<key>Weekday</key>
			<integer>2</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>20</integer>
			<key>Minute</key>
			<integer>40</integer>
			<key>Weekday</key>
			<integer>3</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>20</integer>
			<key>Minute</key>
			<integer>40</integer>
			<key>Weekday</key>
			<integer>4</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>20</integer>
			<key>Minute</key>
			<integer>40</integer>
			<key>Weekday</key>
			<integer>5</integer>
		</dict>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/kaneyoun/DriveForALL/StoLab/MagicFormula</string>
</dict>
</plist>
